---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
const lastUpdated = new Date().toISOString().slice(0, 10); // YYYY-MM-DD
---

<footer class="border-t border-slate-200 mt-16 py-8">
  <div class="max-w-4xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-slate-500">
    <p>&copy; {currentYear} Yusaku Kato. All rights reserved.</p>
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/Yusaku-Kato"
        class="hover:text-slate-700 no-underline"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        GitHub
      </a>
      <a
        data-e="vf0610xf@rq.evgfhzrv.np.wc"
        class="hover:text-slate-700 no-underline"
        aria-label="Email"
        id="footer-email-link"
      >
        Email
      </a>
      <span class="text-slate-400">Last updated: {lastUpdated}</span>
    </div>
  </div>
</footer>

<script>
  (function () {
    function rot13(s) {
      return s.replace(/[a-zA-Z]/g, function (c) {
        return String.fromCharCode(
          c.charCodeAt(0) + (c.toLowerCase() < 'n' ? 13 : -13)
        );
      });
    }
    document.querySelectorAll('a[data-e]').forEach(function (a) {
      a.href = 'mailto:' + rot13(a.dataset.e);
    });
  })();
</script>
