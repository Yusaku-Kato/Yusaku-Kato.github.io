---
// src/components/Header.astro
import NavLink from "./NavLink.astro";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/publications", label: "Publications" },
  { href: "/projects", label: "Projects" },
  { href: "/cv", label: "CV" },
  { href: "/contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-200">
  <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
    <!-- サイト名 -->
    <a href="/" class="text-base font-bold text-slate-900 no-underline hover:text-slate-700">
      Yusaku Kato
    </a>

    <!-- デスクトップナビ -->
    <nav class="hidden sm:flex items-center gap-1" aria-label="Main navigation">
      {navLinks.map((link) => <NavLink href={link.href} label={link.label} />)}
    </nav>

    <!-- モバイルメニュー（シンプルなリスト表示） -->
    <details class="sm:hidden relative">
      <summary class="cursor-pointer list-none p-2 text-slate-600 hover:text-slate-900">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <nav
        class="absolute right-0 top-full mt-2 w-48 bg-white border border-slate-200 rounded-xl shadow-lg py-2 flex flex-col"
        aria-label="Mobile navigation"
      >
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-slate-900 no-underline"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
