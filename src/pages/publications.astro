---
// src/pages/publications.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPublications = await getCollection("publications");

// 年の降順でソート
const sorted = allPublications.sort((a, b) => b.data.year - a.data.year);

// 年でグルーピング
const byYear: Record<number, typeof sorted> = {};
for (const pub of sorted) {
  const y = pub.data.year;
  if (!byYear[y]) byYear[y] = [];
  byYear[y].push(pub);
}
const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);

const typeLabel: Record<string, string> = {
  journal: "Journal",
  conference: "Conference",
  workshop: "Workshop",
  preprint: "Preprint",
  other: "Other",
};

const typeColor: Record<string, string> = {
  journal: "bg-emerald-100 text-emerald-800",
  conference: "bg-blue-100 text-blue-800",
  workshop: "bg-amber-100 text-amber-800",
  preprint: "bg-violet-100 text-violet-800",
  other: "bg-slate-100 text-slate-700",
};
---

<BaseLayout
  title="Publications — Yusaku Kato"
  description="List of research publications by Yusaku Kato."
>
  <div class="page-container space-y-12">
    <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">Publications</h1>
        <p class="text-slate-500 mt-1 text-sm">
          Total: {allPublications.length} papers
        </p>
      </div>
      <a
        href="https://scholar.google.com/citations?user=XXXXXXXXX"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-link self-start sm:self-auto"
        id="pub-scholar-link"
      >
        Google Scholar ↗
        <!-- ↑ Google Scholar URL を変更してください -->
      </a>
    </header>

    {years.map((year) => (
      <section aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="text-xl font-bold text-slate-900 mb-5 flex items-center gap-3">
          {year}
          <span class="text-sm font-normal text-slate-400">({byYear[year].length})</span>
        </h2>
        <ul class="space-y-8 list-none pl-0">
          {byYear[year].map((pub) => (
            <li class="border-l-2 border-slate-200 pl-5 space-y-2" id={`pub-${pub.slug}`}>
              {/* タイトル */}
              <p class="font-semibold text-slate-900 leading-snug text-base">
                {pub.data.title}
              </p>
              {/* 著者 */}
              <p class="text-sm text-slate-700">
                {pub.data.authors.map((author, i) => (
                  <span>
                    {author === "Yusaku Kato" ? (
                      <strong class="text-slate-900">{author}</strong>
                    ) : (
                      author
                    )}
                    {i < pub.data.authors.length - 1 && ", "}
                  </span>
                ))}
              </p>
              {/* 掲載先 */}
              <p class="text-sm text-slate-600 italic">{pub.data.venue}</p>
              {/* タグ行 */}
              <div class="flex flex-wrap items-center gap-2">
                <span
                  class={`inline-block text-xs font-semibold px-2 py-0.5 rounded-full ${typeColor[pub.data.type] ?? typeColor.other}`}
                >
                  {typeLabel[pub.data.type] ?? pub.data.type}
                </span>
                {pub.data.doi && (
                  <a
                    href={`https://doi.org/${pub.data.doi}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-link"
                  >
                    DOI
                  </a>
                )}
                {pub.data.pdf && (
                  <a href={pub.data.pdf} class="btn-link">PDF</a>
                )}
                {pub.data.code && (
                  <a
                    href={pub.data.code}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-link"
                  >
                    Code
                  </a>
                )}
                {pub.data.slides && (
                  <a href={pub.data.slides} class="btn-link">Slides</a>
                )}
                {pub.data.tags?.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              {/* BibTeX */}
              {pub.data.bibtex && (
                <details class="mt-1">
                  <summary class="cursor-pointer text-xs text-slate-400 hover:text-slate-600 select-none">
                    BibTeX
                  </summary>
                  <div class="relative mt-2">
                    <pre
                      id={`bibtex-${pub.slug}`}
                      class="bg-slate-50 border border-slate-200 rounded-lg p-4 text-xs text-slate-700 overflow-x-auto whitespace-pre-wrap"
                    >{pub.data.bibtex}</pre>
                    <button
                      class="absolute top-2 right-2 text-xs btn-link"
                      onclick={`navigator.clipboard.writeText(document.getElementById('bibtex-${pub.slug}').textContent).then(()=>{this.textContent='Copied!';setTimeout(()=>{this.textContent='Copy'},1500)})`}
                    >
                      Copy
                    </button>
                  </div>
                </details>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}

  </div>
</BaseLayout>
