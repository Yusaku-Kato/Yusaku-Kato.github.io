---
// src/pages/projects.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");

// featured を先頭に
const sorted = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});
---

<BaseLayout
  title="Projects — Yusaku Kato"
  description="Research projects by Yusaku Kato."
>
  <div class="page-container space-y-10">
    <header>
      <h1 class="text-3xl font-bold text-slate-900">Projects</h1>
      <p class="text-slate-500 mt-2 text-sm leading-relaxed max-w-2xl">
        An overview of research and development projects I have been involved in.
      </p>
    </header>

    <ul class="grid sm:grid-cols-2 gap-5 list-none pl-0">
      {sorted.map((proj) => (
        <li class="card flex flex-col gap-3" id={`project-${proj.slug}`}>
          <div class="flex items-start justify-between gap-2">
            <h2 class="text-base font-semibold text-slate-900 leading-snug">
              {proj.data.title}
            </h2>
            {proj.data.featured && (
              <span class="flex-shrink-0 tag text-xs bg-blue-50 text-blue-700">Featured</span>
            )}
          </div>

          <p class="text-xs text-slate-400 font-medium">
            {proj.data.period}
            {proj.data.role && ` · ${proj.data.role}`}
          </p>

          <p class="text-sm text-slate-700 leading-relaxed flex-1">
            {proj.data.summary}
          </p>

          {/* 使用技術 */}
          {proj.data.technologies && proj.data.technologies.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {proj.data.technologies.map((tech) => (
                <span class="tag">{tech}</span>
              ))}
            </div>
          )}

          {/* リンク */}
          {proj.data.links && proj.data.links.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-1 border-t border-slate-100">
              {proj.data.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-link"
                >
                  {link.label} ↗
                </a>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
