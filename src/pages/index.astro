---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Featured publications（最大3件。年の降順、同じ年なら月の降順）
const allPublications = await getCollection("publications");
const featuredPubs = allPublications
  .filter((p) => p.data.featured)
  .sort((a, b) => {
    if (b.data.year !== a.data.year) {
      return b.data.year - a.data.year;
    }
    const aMonth = a.data.month ?? 0;
    const bMonth = b.data.month ?? 0;
    return bMonth - aMonth;
  })
  .slice(0, 3);

// Featured projects（最大2件）
const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .slice(0, 2);

// 最新ニュース（最新3件）
const allNews = await getCollection("news");
const latestNews = allNews
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// 型ラベル
const typeLabel: Record<string, string> = {
  journal: "Journal",
  conference: "Conference",
  workshop: "Workshop",
  preprint: "Preprint",
  other: "Other",
};

// Research Interests
const researchInterests = [
  "Software Engineering",
  "Automated Software Testing",
  "Fuzzing",
  "Multi Objective Optimization",
  "Video Game Testing",
];
---

<BaseLayout
  title="Yusaku Kato — Researcher"
  description="Yusaku Kato's personal research homepage. AI, HCI, and Web Engineering."
>
  <div class="page-container space-y-16">

    <!-- Hero -->
    <section aria-label="Introduction" class="flex flex-col sm:flex-row items-start gap-8 pt-4">
      <div class="flex-1 space-y-4">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900">
          Yusaku Kato
          {/* ↑ 名前を変更してください */}
        </h1>
        <p class="text-lg text-slate-600 font-medium">
          Ritsumeikan University
        </p>
        <p class="text-base text-slate-700 leading-relaxed max-w-2xl">
          I am a master's student at Ritsumeikan University. My specialization is <strong>Software Engineering</strong>. Currently, for my master's research, I am working on <strong>Test Automation</strong> for <strong>Observational Non-Deterministic Systems</strong>.
        </p>

        <!-- リンク集 -->
        <div class="flex flex-wrap gap-3 pt-2">
          <a data-e="vf0610xf@rq.evgfhzrv.np.wc" class="btn-link" id="hero-email-link">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
            </svg>
            Email
          </a>
          <a href="https://github.com/Yusaku-Kato" target="_blank" rel="noopener noreferrer" class="btn-link" id="hero-github-link">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a href="https://scholar.google.com/citations?user=mSuD-j4AAAAJ&hl=ja&authuser=1" target="_blank" rel="noopener noreferrer" class="btn-link" id="hero-scholar-link">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 24a7 7 0 110-14 7 7 0 010 14zm0-24L0 9.5l4.838 3.94A8 8 0 0112 10a8 8 0 017.162 3.44L24 9.5 12 0z"/>
            </svg>
            Google Scholar
          </a>
          <a href="/cv" class="btn-link" id="hero-cv-link">CV →</a>
        </div>
      </div>
    </section>

    <!-- Research Interests -->
    <section aria-labelledby="interests-heading">
      <h2 id="interests-heading" class="section-title">Research Interests</h2>
      <ul class="grid sm:grid-cols-2 gap-3 list-none pl-0">
        {researchInterests.map((interest) => (
          <li class="flex items-start gap-2 text-slate-700">
            <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-slate-400"></span>
            {interest}
          </li>
        ))}
      </ul>
    </section>

    <!-- News -->
    {latestNews.length > 0 && (
      <section aria-labelledby="news-heading">
        <h2 id="news-heading" class="section-title">News</h2>
        <ul class="space-y-4 list-none pl-0">
          {latestNews.map((item) => (
            <li class="flex gap-4 items-start">
              <time
                datetime={item.data.date.toISOString().slice(0, 10)}
                class="flex-shrink-0 text-sm text-slate-400 font-mono pt-0.5 w-24"
              >
                {item.data.date.toISOString().slice(0, 10)}
              </time>
              <div>
                {item.data.link ? (
                  <a href={item.data.link} class="font-medium text-slate-900 hover:text-blue-600">
                    {item.data.title}
                  </a>
                ) : (
                  <p class="font-medium text-slate-900">{item.data.title}</p>
                )}
                {item.data.summary && (
                  <p class="text-sm text-slate-600 mt-0.5">{item.data.summary}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Featured Publications -->
    {featuredPubs.length > 0 && (
      <section aria-labelledby="publications-heading">
        <h2 id="publications-heading" class="section-title">Selected Publications</h2>
        <ul class="space-y-5 list-none pl-0">
          {featuredPubs.map((pub) => (
            <li class="border-l-2 border-slate-200 pl-4">
              <p class="font-semibold text-slate-900 leading-snug">{pub.data.title}</p>
              <p class="text-sm text-slate-600 mt-0.5">{pub.data.authors.join(", ")}</p>
              <p class="text-sm text-slate-500 mt-0.5 italic">{pub.data.venue} · {pub.data.year}</p>
              <div class="flex flex-wrap gap-2 mt-1.5">
                <span class="tag">{typeLabel[pub.data.type] ?? pub.data.type}</span>
                {pub.data.doi && (
                  <a href={`https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener noreferrer" class="btn-link">DOI</a>
                )}
                {pub.data.pdf && <a href={pub.data.pdf} class="btn-link">PDF</a>}
                {pub.data.code && (
                  <a href={pub.data.code} target="_blank" rel="noopener noreferrer" class="btn-link">Code</a>
                )}
              </div>
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <a href="/publications" class="text-sm font-medium text-blue-600 hover:text-blue-800">View all publications →</a>
        </div>
      </section>
    )}

    <!-- Featured Projects -->
    {featuredProjects.length > 0 && (
      <section aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="section-title">Featured Projects</h2>
        <ul class="grid sm:grid-cols-2 gap-4 list-none pl-0">
          {featuredProjects.map((proj) => (
            <li class="card">
              <h3 class="font-semibold text-slate-900 text-base">{proj.data.title}</h3>
              <p class="text-sm text-slate-500 mt-0.5">{proj.data.period}</p>
              <p class="text-sm text-slate-700 mt-2 leading-relaxed">{proj.data.summary}</p>
              {proj.data.technologies && (
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {proj.data.technologies.map((tech) => <span class="tag">{tech}</span>)}
                </div>
              )}
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <a href="/projects" class="text-sm font-medium text-blue-600 hover:text-blue-800">View all projects →</a>
        </div>
      </section>
    )}

  </div>
</BaseLayout>

<script>
  (function () {
    function rot13(s) {
      return s.replace(/[a-zA-Z]/g, function (c) {
        return String.fromCharCode(
          c.charCodeAt(0) + (c.toLowerCase() < 'n' ? 13 : -13)
        );
      });
    }
    document.querySelectorAll('a[data-e]').forEach(function (a) {
      a.href = 'mailto:' + rot13(a.dataset.e);
    });
  })();
</script>
