---
// src/pages/contact.astro
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact — Yusaku Kato"
  description="Contact information for Yusaku Kato."
>
  <div class="page-container max-w-2xl space-y-10">
    <header>
      <h1 class="text-3xl font-bold text-slate-900">Contact</h1>
      <p class="text-slate-600 mt-2 leading-relaxed">
        Feel free to reach out for research inquiries, collaborations, or any questions.
      </p>
    </header>

    <ul class="space-y-5 list-none pl-0">
      <!-- Email -->
      <li class="card flex items-start gap-5">
        <div class="flex-shrink-0 mt-0.5 h-9 w-9 rounded-lg bg-slate-100 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-600" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Email</p>
          <a href="mailto:yusaku.kato@example.com" class="text-base font-medium text-slate-900 hover:text-blue-600" id="contact-email">
            yusaku.kato@example.com
            <!-- ↑ メールアドレスを変更してください -->
          </a>
        </div>
      </li>

      <!-- GitHub -->
      <li class="card flex items-start gap-5">
        <div class="flex-shrink-0 mt-0.5 h-9 w-9 rounded-lg bg-slate-100 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-600" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide">GitHub</p>
          <a href="https://github.com/Yusaku-Kato" target="_blank" rel="noopener noreferrer" class="text-base font-medium text-slate-900 hover:text-blue-600" id="contact-github">
            github.com/Yusaku-Kato
          </a>
        </div>
      </li>

      <!-- Google Scholar -->
      <li class="card flex items-start gap-5">
        <div class="flex-shrink-0 mt-0.5 h-9 w-9 rounded-lg bg-slate-100 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-600" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 24a7 7 0 110-14 7 7 0 010 14zm0-24L0 9.5l4.838 3.94A8 8 0 0112 10a8 8 0 017.162 3.44L24 9.5 12 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Google Scholar</p>
          <a
            href="https://scholar.google.com/citations?user=XXXXXXXXX"
            target="_blank"
            rel="noopener noreferrer"
            class="text-base font-medium text-slate-900 hover:text-blue-600"
            id="contact-scholar"
          >
            Google Scholar Profile
            <!-- ↑ URL を変更してください -->
          </a>
        </div>
      </li>

      <!-- ORCID -->
      <li class="card flex items-start gap-5">
        <div class="flex-shrink-0 mt-0.5 h-9 w-9 rounded-lg bg-slate-100 flex items-center justify-center">
          <span class="text-xs font-bold text-slate-600">ID</span>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide">ORCID</p>
          <a
            href="https://orcid.org/0000-0000-0000-0000"
            target="_blank"
            rel="noopener noreferrer"
            class="text-base font-medium text-slate-900 hover:text-blue-600"
            id="contact-orcid"
          >
            0000-0000-0000-0000
            <!-- ↑ ORCID を変更してください -->
          </a>
        </div>
      </li>

      <!-- LinkedIn (オプション) -->
      <!-- <li class="card flex items-start gap-5">
        <div class="flex-shrink-0 mt-0.5 h-9 w-9 rounded-lg bg-slate-100 flex items-center justify-center">
          <span class="text-xs font-bold text-slate-600">in</span>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide">LinkedIn</p>
          <a href="https://linkedin.com/in/yusaku-kato" target="_blank" rel="noopener noreferrer" class="text-base font-medium text-slate-900 hover:text-blue-600" id="contact-linkedin">
            linkedin.com/in/yusaku-kato
          </a>
        </div>
      </li> -->
    </ul>

    <!-- 注記 -->
    <p class="text-sm text-slate-400 border-t border-slate-100 pt-6">
      For research inquiries or collaboration proposals, please include a brief description
      of your interest when contacting me.
    </p>
  </div>
</BaseLayout>
