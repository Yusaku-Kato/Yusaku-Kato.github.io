---
// src/pages/cv.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPublications = await getCollection("publications");
const pubs = allPublications.sort((a, b) => {
  if (b.data.year !== a.data.year) {
    return b.data.year - a.data.year;
  }
  const aMonth = a.data.month ?? 0;
  const bMonth = b.data.month ?? 0;
  return bMonth - aMonth;
});

const basicInfo = [
  { label: "Name", value: "Yusaku Kato" },
  { label: "Affiliation", value: "Ritsumeikan University" },
  { label: "Email", value: "", isEmail: true },
  { label: "GitHub", value: "github.com/Yusaku-Kato" },
  // ↑ 基本情報を変更してください
];

const education = [
  { degree: "Master's Program, Graduate School of Information Science and Engineering, Major in Advanced Information Science and Engineering", school: "Ritsumeikan University", period: "Apr. 2025–Present", note: "" },
  { degree: "College of Information Science and Engineering, Department of Information Science and Engineering", school: "Ritsumeikan University", period: "Apr. 2021–Mar. 2025", note: "" },
  // ↑ 学歴を変更してください
];

const career = [
  { title: "Research Intern", org: "Hitachi, Ltd. Yokohama Research Laboratory", period: "Jan. 2025", note: "Research & Development" },
  // ↑ 職歴を変更してください
];

const awards = [
  { name: "研究奨励賞", event: "立命館大学 大学院情報理工学研究科", year: "2026" },
  { name: "ポスター・デモ賞", event: "日本ソフトウェア科学会 第31回ソフトウェア工学の基礎ワークショップ （FOSE2024）", year: "2024" },
  // ↑ 受賞歴を変更してください
];

const skillGroups = [
  { category: "Programming Languages", items: ["C", "C#", "Python", "JavaScript"] },
  { category: "Frameworks & Libraries", items: ["Unity", "Flutter", "React", "Astro"] },
  { category: "Languages", items: ["Japanese (Native)", "English (Conversational)"] },
  // ↑ スキルを変更してください
];
---

<BaseLayout
  title="CV — Yusaku Kato"
  description="Curriculum vitae of Yusaku Kato."
>
  <div class="page-container space-y-10">

    <!-- ヘッダー -->
    <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">Curriculum Vitae</h1>
        <p class="text-slate-500 mt-1 text-sm">Last updated: May 2026</p>
      </div>
      <a
        href="/cv.pdf"
        class="btn-link self-start"
        id="cv-pdf-download"
        download
      >
        {/* ↑ public/cv.pdf に実際の PDF を配置してください */}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
        </svg>
        Download PDF
      </a>
    </header>

    <!-- 基本情報 -->
    <section aria-labelledby="cv-info-heading">
      <h2 id="cv-info-heading" class="section-title">Basic Information</h2>
      <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
        {basicInfo.map((item) => (
          <div>
            <dt class="text-slate-400 font-medium">{item.label}</dt>
            {item.isEmail ? (
              <dd class="text-slate-800"><span data-email-text="vf0610xf@rq.evgfhzrv.np.wc"></span></dd>
            ) : (
              <dd class="text-slate-800">{item.value}</dd>
            )}
          </div>
        ))}
      </dl>
    </section>

    <!-- 学歴 -->
    <section aria-labelledby="cv-edu-heading">
      <h2 id="cv-edu-heading" class="section-title">Education</h2>
      <ul class="space-y-4 list-none pl-0">
        {education.map((edu) => (
          <li class="flex gap-4">
            <span class="text-slate-400 text-sm font-mono flex-shrink-0 w-24">{edu.period}</span>
            <div>
              <p class="font-semibold text-slate-900">{edu.degree}</p>
              <p class="text-slate-600 text-sm">{edu.school}</p>
              {edu.note && <p class="text-slate-400 text-sm">{edu.note}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- 職歴・研究歴 -->
    <section aria-labelledby="cv-career-heading">
      <h2 id="cv-career-heading" class="section-title">Career & Research Experience</h2>
      <ul class="space-y-4 list-none pl-0">
        {career.map((job) => (
          <li class="flex gap-4">
            <span class="text-slate-400 text-sm font-mono flex-shrink-0 w-24">{job.period}</span>
            <div>
              <p class="font-semibold text-slate-900">{job.title}</p>
              <p class="text-slate-600 text-sm">{job.org}</p>
              {job.note && <p class="text-slate-400 text-sm">{job.note}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- 論文 -->
    <section aria-labelledby="cv-pub-heading">
      <h2 id="cv-pub-heading" class="section-title">Publications</h2>
      <ol class="space-y-4 list-none pl-0">
        {pubs.map((pub, i) => (
          <li class="flex gap-3 text-sm">
            <span class="text-slate-400 font-mono flex-shrink-0">[{pubs.length - i}]</span>
            <p class="text-slate-900 leading-relaxed">
              <span class="font-medium">{pub.data.title}.</span>{" "}
              {pub.data.authors.map((a, j) => (
                <span>
                  {a === "Yusaku Kato" ? <strong>{a}</strong> : a}
                  {j < pub.data.authors.length - 1 && ", "}
                </span>
              ))}.{" "}
              <em>{pub.data.venue}</em>. {pub.data.year}.
              {pub.data.doi && (
                <a href={`https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener noreferrer" class="ml-1 text-blue-600">DOI</a>
              )}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 受賞 -->
    <section aria-labelledby="cv-awards-heading">
      <h2 id="cv-awards-heading" class="section-title">Awards & Honors</h2>
      <ul class="space-y-3 list-none pl-0 text-sm">
        {awards.map((award) => (
          <li class="flex gap-4">
            <span class="text-slate-400 font-mono flex-shrink-0 w-12">{award.year}</span>
            <div>
              <p class="font-medium text-slate-900">{award.name}</p>
              <p class="text-slate-500">{award.event}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- スキル -->
    <section aria-labelledby="cv-skills-heading">
      <h2 id="cv-skills-heading" class="section-title">Skills</h2>
      <div class="space-y-3 text-sm">
        {skillGroups.map((group) => (
          <div class="flex gap-4">
            <span class="text-slate-400 font-medium min-w-40 flex-shrink-0">{group.category}</span>
            <span class="text-slate-700">{group.items.join(", ")}</span>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  (function () {
    function rot13(s) {
      return s.replace(/[a-zA-Z]/g, function (c) {
        return String.fromCharCode(
          c.charCodeAt(0) + (c.toLowerCase() < 'n' ? 13 : -13)
        );
      });
    }
    document.querySelectorAll('[data-email-text]').forEach(function (el) {
      el.textContent = rot13(el.dataset.emailText);
    });
  })();
</script>
